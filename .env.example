NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://reprgb:CHANGE_ME@127.0.0.1:5432/reprgb
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# TMDB v3 API key, not a bearer access token
TMDB_API_KEY=
# Leave Frigate URL unset until configured. Mode must be explicit when set.
# FRIGATE_URL=https://frigate.lan:8971/
# FRIGATE_AUTH_MODE=account
# FRIGATE_USERNAME=reprgb-viewer
# FRIGATE_PASSWORD=
# FRIGATE_CA_FILE=/run/secrets/frigate-ca.pem
# Internal mode uses a restricted private endpoint, never a fallback.
# FRIGATE_AUTH_MODE=internal
# FRIGATE_URL=http://frigate:5000/
FRIGATE_CAMERAS=[]
# Docker Compose: use a URL-safe password (hex is convenient).
POSTGRES_PASSWORD=replace-with-a-random-hex-password
SITE_HOST=localhost
# With Compose change APP_ORIGIN above to https://localhost (or your LAN host).
